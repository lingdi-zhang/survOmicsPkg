set.seed(123)
n_subjects <- 200
n_biomarkers <- 100
n_visits <- 5
subject_data <- data.frame(
id = 1:n_subjects,
age = rnorm(n_subjects, 50, 10),
sex = sample(c("Female", "Male"), n_subjects, replace = TRUE),
baseline_risk = rnorm(n_subjects)
)
head(subject_data)
toy_metadata <- data.frame(
id    = c(1,1,1,2,2,3,3,4,4,5),
time  = c(0,2,6,0,2,0,2,0,4,0),
event = c(0,0,1,0,1,0,0,0,1,0)
)
baseline_biomarkers <- data.frame(
id = c(1,2,3,4,5),
# true risk biomarker
biomarker1 = c(10.2,9.8,4.5,11.3,5.0),
# protective biomarker
biomarker2 = c(2.1,2.5,8.5,1.8,7.9),
# noise biomarkers
biomarker3 = c(4.2,5.1,4.9,5.3,5.0),
biomarker4 = c(8.1,7.9,8.0,8.2,8.1)
)
data(toy_metadata)
data(baseline_biomarkers)
head(toy_metadata)
